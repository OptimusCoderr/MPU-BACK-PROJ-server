{
  "name": "spineguard-vercel",
  "version": "1.0.0",
  "description": "SpineGuard — Vercel serverless deployment",
  "private": true,
  "engines": {
    "node": ">=18.x"
  },
  "scripts": {
    "dev"       : "vercel dev",
    "deploy"    : "vercel --prod",
    "seed"      : "node lib/seed.js",
    "lint"      : "node --check api/**/*.js lib/*.js"
  },
  "dependencies": {
    "dotenv"   : "16.4.5",
    "mongoose" : "8.3.4",
    "pusher"   : "5.2.0"
  },
  "devDependencies": {
    "vercel": "37.4.2"
  }
}
